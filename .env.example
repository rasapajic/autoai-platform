# ============================================================
# AutoAI Platform - Environment Variables
# Kopiraj kao .env i popuni vrednosti
# ============================================================

# ─── Baza podataka ───────────────────────────────────────────
POSTGRES_PASSWORD=secret123
DATABASE_URL=postgresql://admin:secret123@localhost:5432/autoai

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Elasticsearch ───────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ─── AI API ──────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# ─── Security ────────────────────────────────────────────────
SECRET_KEY=promeni_ovo_na_random_string_od_32_karaktera
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# AutoAI M0.1 internal admin access. Use a new random secret; never reuse the
# legacy secret that was previously committed to the repository.
AUTOAI_ADMIN_SECRET=replace_with_new_random_secret

# ─── App ─────────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000

# ─── M0.1 Live Listings Recovery ─────────────────────────────
# Fail closed by default. Enable only for controlled internal recovery runs.
AUTOAI_INTERNAL_LISTING_INGEST_ENABLED=false
AUTOAI_INTERNAL_LISTING_SOURCES=willhaben,mobile_de

# ─── Email (za alertove) ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tvoj@gmail.com
SMTP_PASSWORD=app_password_ovde

# ─── Proxy (za scraping anti-bot zaštitu) ────────────────────
# PROXY_LIST=http://user:pass@proxy1.com:8080,http://user:pass@proxy2.com:8080
