# AutoAI Platform - environment example
# Copy this file to .env and replace all placeholder values.

# Database
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql://autoai:replace-with-strong-password@postgres:5432/autoai

# Redis
REDIS_URL=redis://redis:6379

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# AI API
ANTHROPIC_API_KEY=

# Security
SECRET_KEY=replace-with-random-32-plus-character-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# App
APP_ENV=production
DEBUG=false
CORS_ORIGINS=https://app.example.com

# Public app URL used in emails and deep links
NEXT_PUBLIC_APP_URL=https://app.example.com

# Legacy backend fallback for public app URL
FRONTEND_URL=https://app.example.com

# Browser-visible backend URL used by the frontend
NEXT_PUBLIC_API_URL=https://api.example.com

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AutoAI <no-reply@example.com>

# Scraping / scheduling
ENABLE_SCHEDULED_SCRAPING=false

# Optional proxy list for manual scraper testing only
# PROXY_LIST=http://user:password@proxy.example.com:8080
